# Prisma + Local SQLite connection string.
# We are using SQLite to ensure the demo works completely offline/locally without network errors.
DATABASE_URL="file:./dev.db"
# For production, use a managed Postgres provider (Supabase / Neon / RDS):
# DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?schema=public"

# JWT secret for issuing auth tokens
JWT_SECRET="replace-with-a-long-random-secret"

# Razorpay (mock in dev; real keys in prod)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Uber Sandbox
UBER_CLIENT_ID=""
UBER_CLIENT_SECRET=""
